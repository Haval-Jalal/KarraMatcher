{
  "AllowedHosts": "*",

  // SigningKey star med flit INTE har. Den kommer ur user-secrets lokalt och ur en
  // miljovariabel i Render. En nyckel i en incheckad appsettings ar ingen nyckel.
  "Auth": {
    "Issuer": "karra-matcher",
    "Audience": "karra-matcher-app",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "60.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
