{
  // Host-header-filtrering (checklista 4.3/4.6, #611). Pinnad till Render-hostarna (prod +
  // staging) sa en Host-header-attack / cache-poisoning med en frammande host avvisas med 400.
  // Lokalt och i tester tillats alla: launchSettings satter AllowedHosts=* for Development, och
  // testfabriken satter det uttryckligen. Render-interna health-probes utan Host slapps igenom
  // (HostFilterings AllowEmptyHosts ar pa som standard).
  "AllowedHosts": "karramatcher-api.onrender.com;karramatcher-api-staging.onrender.com",

  // SigningKey star med flit INTE har. Den kommer ur user-secrets lokalt och ur en
  // miljovariabel i Render. En nyckel i en incheckad appsettings ar ingen nyckel.
  "Auth": {
    "Issuer": "karra-matcher",
    "Audience": "karra-matcher-app",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "60.00:00:00"
  },

  // Edge-skyddet (§KM.11, checklista 4.6, #584). SharedSecret star med flit INTE har: den
  // satts som EdgeAuth__SharedSecret i Render och som KARRA_EDGE_AUTH i Vercel. Tom = grinden
  // inert, sa koden kan rullas ut innan hemligheten finns pa bada sidor.
  "EdgeAuth": {
    "SharedSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
