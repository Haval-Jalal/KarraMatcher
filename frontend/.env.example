# Kopiera till .env.local och fyll i. .env-filer checkas ALDRIG in.
#
# Allt med VITE_-prefix bundlas in i klienten och är därmed publikt.
# Lägg aldrig en hemlighet här (CLAUDE.md → Frontend, Miljövariabler).

# Bas-URL för API:t. I drift går anropen genom Vercels rewrite av /api
# till Render, så klienten ser en enda origin (§KM.11). Lokalt pekar den
# direkt på backend.
VITE_API_BASE_URL=http://localhost:5199
