{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://karramatcher-api.onrender.com/api/:path*"
    },
    {
      "source": "/calendar/:path*",
      "destination": "https://karramatcher-api.onrender.com/calendar/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/jobs/match-reminders",
      "schedule": "0 18 * * *"
    }
  ]
}
